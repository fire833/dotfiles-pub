{
  "permissions": {
    "allow": [
      "mcp__prometheus__*",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go fmt *)",
      "Bash(go vet *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gitlab.com)"
    ],
    "deny": [
      "Bash(printenv *)",
      "Bash(shred *)",
      "Bash(bat *)",
      "Bash(pulumi *)",
      "Bash(keepassxc *)",
      "Bash(keepassxc-cli *)",
      "Bash(gpg *)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Read(~/.config/**)",
      "Edit(~/.config/**)",
      "Read(~/.docker/**)",
      "Edit(~/.docker/**)",
      "Read(~/.password-store/**)",
      "Edit(~/.password-store/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.pulumi/**)",
      "Edit(~/.pulumi/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.kt/**)",
      "Edit(~/.kt/**)",
      "Read(/etc/**)",
      "Edit(/etc/**)",
      "Read(/var/**)",
      "Edit(/var/**)"
    ],
    "ask": [
      "WebFetch(domain:*)",
      "Bash(aws *)",
      "Bash(kubectl *)",
      "mcp__gitlab__*",
      "mcp__incidentio__*"
    ],
    "defaultMode": "default"
  },
  "effortLevel": "medium",
  "autoMemoryDirectory": "~/.claude/memory",
  "theme": "dark",
  "model": "sonnet"
}
