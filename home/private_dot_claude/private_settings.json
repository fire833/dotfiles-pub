{
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "mcp__prometheus__*",
      "Bash(go build *)",
      "Bash(go generate *)",
      "Bash(go test *)",
      "Bash(go fmt *)",
      "Bash(gofumpt *)",
      "Bash(go vet *)",
      "Bash(cargo build *)",
      "Bash(cargo bench *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(tmpl *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gitlab.com)"
    ],
    "deny": [
      "Bash(printenv *)",
      "Bash(shred *)",
      "Bash(bat *)",
      "Bash(procs *)",
      "Bash(pulumi *)",
      "Bash(keepassxc *)",
      "Bash(keepassxc-cli *)",
      "Bash(nmcli *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(gpg *)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Bash(cat *.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Bash(cat *.aws/**)",
      "Read(~/.claude/**)",
      "Edit(~/.claude/**)",
      "Bash(cat *.claude/**)",
      "Read(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Bash(cat *.claude.json)",
      "Read(~/.config/**)",
      "Edit(~/.config/**)",
      "Bash(cat *.config/**)",
      "Read(~/.docker/**)",
      "Edit(~/.docker/**)",
      "Bash(cat *.docker/**)",
      "Read(~/.password-store/**)",
      "Edit(~/.password-store/**)",
      "Bash(cat *.password-store/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Bash(cat *.gnupg/**)",
      "Read(~/.pulumi/**)",
      "Edit(~/.pulumi/**)",
      "Bash(cat *.pulumi/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Bash(cat *.kube/**)",
      "Read(~/.kt/**)",
      "Edit(~/.kt/**)",
      "Bash(cat *.kt/**)",
      "Read(/etc/**)",
      "Edit(/etc/**)",
      "Bash(cat /etc/**)",
      "Read(/var/**)",
      "Edit(/var/**)",
      "Bash(cat /var/**)"
    ],
    "ask": [
      "WebFetch(domain:*)",
      "Bash(git *)",
      "Bash(aws *)",
      "Bash(kubectl *)",
      "Bash(go tool *)",
      "Bash(go mod *)",
      "Bash(go get *)",
      "Bash(go install *)",
      "Bash(go run *)",
      "Bash(go work *)",
      "Bash(cargo *)",
      "Bash(cargo init *)",
      "Bash(cargo add *)",
      "Bash(cargo remove *)",
      "Bash(cargo install *)",
      "Bash(cargo uninstall *)",
      "Bash(cargo publish *)",
      "Bash(ps *)",
      "mcp__gitlab__*",
      "mcp__incidentio__*"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "~/.ssh/*",
        "~/.aws/*",
        "~/.claude/*",
        "~/.claude/settings.json",
        "~/.config/*",
        "~/.docker/*",
        "~/.local/*",
        "~/.gnupg/*",
        "~/.pulumi/*",
        "~/.password-store/*",
        "~/.kube/*",
        "~/.kt/*",
        "/etc/*"
      ],
      "denyRead": [
        "~/.ssh/*",
        "~/.aws/*",
        "~/.claude/*",
        "~/.claude/settings.json",
        "~/.config/*",
        "~/.docker/*",
        "~/.local/*",
        "~/.gnupg/*",
        "~/.pulumi/*",
        "~/.password-store/*",
        "~/.kube/*",
        "~/.kt/*",
        "/etc/*"
      ]
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoMemoryDirectory": "~/.claude/memory",
  "theme": "dark",
  "switchModelsOnFlag": true,
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
