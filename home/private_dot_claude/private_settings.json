{
  "permissions": {
    "allow": [
      "WebFetch(domain:*)"
    ],
    "deny": [
      "Bash(printenv *)",
      "Bash(shred *)",
      "Bash(bat *)",
      "Bash(pulumi *)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/**)",
      "Read(~/.config/**)",
      "Read(/etc/**)",
      "Read(/var/**)"
    ],
    "ask": [
      "Bash(aws *)",
      "Bash(kubectl *)"
    ]
  },
  "effortLevel": "high",
  "autoMemoryDirectory": "~/.claude/memory",
  "theme": "dark",
  "defaultMode": "manual"
}
